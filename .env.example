# Database: the same Supabase Postgres as api-colegio-smart (pooler, port 5432 session mode).
# Note the SQLAlchemy URL format, not JDBC.
DATABASE_URL=postgresql+psycopg://postgres.your_project_ref:your_password@aws-0-xx.pooler.supabase.com:5432/postgres?sslmode=require

# JWT: SAME values as api-colegio-smart (the session cookie is issued there).
JWT_SECRET=same_secret_as_api_colegio_smart
JWT_ISSUER=colegio-smart-api
JWT_AUDIENCE=colegio-smart-app
AUTH_COOKIE_NAME=cs_session
CSRF_COOKIE_SECURE=true

CORS_ALLOWED_ORIGINS=https://lectura.colegiosmart.cl

# Cloudflare R2: a PRIVATE bucket only for reading audio (student voices). Not the public avatars bucket.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_READING_BUCKET=colegiosmart-lectura-audio
PRESIGNED_TTL_SECONDS=900

# Claude API: AI reports (only figures, never names).
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# Worker inside the API process. One process only: each one loads the models.
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1.0

# Optional Whisper engine (config/motor.json "motor": "whisper"): model and precision on CPU.
LECTURA_WHISPER_MODELO=large-v3-turbo
LECTURA_WHISPER_COMPUTE=int8
